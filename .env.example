# Email delivery for enquiries. Required in production. Leave unset in development to use the log mailer.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Where enquiries are delivered and the sender address on the same domain.
ENQUIRY_TO=
ENQUIRY_FROM=

# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://arqoneailabs.space

# Set to "on" to enable cookie-free analytics.
NEXT_PUBLIC_ANALYTICS=off
